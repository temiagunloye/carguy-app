{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "JobDoc",
    "type": "object",
    "required": [
        "jobId",
        "status",
        "createdAt"
    ],
    "properties": {
        "jobId": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "UPLOADED",
                "VALIDATING",
                "EXTRACTING",
                "SEGMENTING",
                "COLMAP",
                "PROXY_ANCHORS",
                "REALITY_TWIN_STUB",
                "PACKAGING",
                "READY",
                "FAILED",
                "RETAKE_REQUIRED"
            ]
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        },
        "errorReason": {
            "type": "string"
        },
        "inputVideoPath": {
            "type": "string"
        }
    }
}